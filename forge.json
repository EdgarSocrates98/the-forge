{
  "forge_id": "the-forge",
  "package": "theforge",
  "distribution": "theforge-core",
  "cli": "theforge",
  "python": ">=3.11",
  "version": "0.7.7",
  "mcp_server_name": "theforge",
  "mcp_command": [
    "theforge",
    "mcp",
    "serve"
  ],
  "mcp_verify_tool": "theforge_status",
  "installation_kind": "control-tool",
  "install": {
    "operations": [
      "plan",
      "apply",
      "status",
      "doctor",
      "repair",
      "update",
      "uninstall",
      "auto",
      "mcp-verify"
    ],
    "flags": [
      "--scope",
      "--root",
      "--host",
      "--profile",
      "--components",
      "--gateway-profile",
      "--yes",
      "--dry-run",
      "--json",
      "--forge",
      "--member",
      "--purge",
      "--to",
      "--repo"
    ],
    "hosts": [
      "claude",
      "devin",
      "codex",
      "copilot"
    ],
    "scopes": [
      "project",
      "workspace",
      "user"
    ],
    "profiles": [
      "minimal",
      "recommended",
      "full"
    ],
    "approval": "--yes"
  },
  "depends_on": [],
  "extras": [
    "mcp"
  ],
  "lab": {
    "command": [
      "{python}",
      "scripts/lab/theforge_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "theforge-lab",
    "timeout_s": 120
  }
}
