{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "nodes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "provider": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "enum": [
              "registry",
              "health"
            ]
          },
          "state": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "state",
          "reason",
          "suggested_action",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "planning_only": {
      "enum": [
        true
      ]
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "producer",
    "created_at",
    "run_id"
  ],
  "title": "InstallationPlan",
  "type": "object"
}
