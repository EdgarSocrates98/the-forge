{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_scope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "auth_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "type": "string"
    },
    "locator": {
      "type": "string"
    },
    "product_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "additionalProperties": {},
      "type": "object"
    },
    "retention_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "state": {
      "enum": [
        "active",
        "paused",
        "revoked",
        "unknown"
      ]
    },
    "sync_config": {
      "additionalProperties": {},
      "type": "object"
    },
    "version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_id": {
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_type",
    "locator",
    "workspace_id"
  ],
  "title": "KnowledgeSource",
  "type": "object"
}
