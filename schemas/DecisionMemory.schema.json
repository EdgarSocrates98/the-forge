{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "type": "string"
          },
          "choice": {
            "type": "string"
          },
          "corroborations": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "routing",
              "profile",
              "pattern",
              "verdict"
            ]
          },
          "runs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "subject": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
