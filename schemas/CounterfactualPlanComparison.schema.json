{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternative_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "base_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "differences": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "predicted_bounds": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "schema": {
      "type": "string"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "producer",
    "created_at",
    "base_sha256",
    "alternative_sha256"
  ],
  "title": "CounterfactualPlanComparison",
  "type": "object"
}
