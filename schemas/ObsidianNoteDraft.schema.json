{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "content": {
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "schema": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "unresolved": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "updated_at": {
      "type": "string"
    },
    "vault_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "workspace": {
      "type": "string"
    }
  },
  "required": [
    "workspace",
    "vault_id",
    "path",
    "source",
    "content",
    "content_hash"
  ],
  "title": "ObsidianNoteDraft",
  "type": "object"
}
