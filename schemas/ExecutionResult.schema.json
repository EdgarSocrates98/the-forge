{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifacts": {
      "items": {
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "evidence": {
      "items": {
        "properties": {
          "claim": {
            "type": "string"
          },
          "epistemic": {
            "enum": [
              "confirmed",
              "observed",
              "inferred",
              "proposed",
              "unresolved"
            ]
          },
          "hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "location": {
            "anyOf": [
              {
                "properties": {
                  "line": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "producer": {
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "epistemic",
          "subject",
          "claim",
          "producer"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "properties": {
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "metrics": {
      "properties": {
        "context_bytes": {
          "properties": {
            "kind": {
              "enum": [
                "measured",
                "estimated",
                "unknown"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "type": "object"
        },
        "duration_ms": {
          "properties": {
            "kind": {
              "enum": [
                "measured",
                "estimated",
                "unknown"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "type": "object"
        },
        "tokens": {
          "properties": {
            "kind": {
              "enum": [
                "measured",
                "estimated",
                "unknown"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "producer": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial"
      ]
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "producer",
    "created_at",
    "status"
  ],
  "title": "ExecutionResult",
  "type": "object"
}
