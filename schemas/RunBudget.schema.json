    },
    "profile": {
      "type": "string"
    },
    "provider_calls": {
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "semantic_calls": {
      "type": "integer"
    },
    "verification_calls": {
      "type": "integer"
    },
    "wall_time_s": {
      "type": "number"
    }
  },
  "required": [
    "producer",
    "created_at",
    "run_id",
    "profile",
    "context_bytes",
    "max_files",
    "provider_calls",
    "semantic_calls",
    "verification_calls",
    "wall_time_s",
    "max_parallelism",
    "negotiation_rounds"
