{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adjustments": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "context_bytes": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "max_files": {
      "type": "integer"
    },
    "max_parallelism": {
      "type": "integer"
    },
    "negotiation_rounds": {
      "type": "integer"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
