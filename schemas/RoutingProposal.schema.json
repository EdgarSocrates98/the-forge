{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alternatives": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "choice": {
      "properties": {
        "action": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "capability"
      ],
      "type": "object"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "choice"
  ],
  "title": "RoutingProposal",
  "type": "object"
}
