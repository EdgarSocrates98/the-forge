            "type": "object"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "evidence_by_epistemic": {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              "findings": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "evidence_ids": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "id": {
                      "type": "string"
                    },
                    "severity": {
                      "enum": [
                        "info",
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "node": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "run_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "ok",
                  "partial",
                  "refused",
                  "provider_failure",
                  "no_route",
                  "skipped"
                ]
              }
            },
            "required": [
              "node",
              "provider",
              "capability",
              "action",
              "status",
              "run_id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "type": "object"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "producer",
    "created_at",
    "status",
    "plan_run",
    "order",
    "nodes",
    "synthesis",
    "reproducibility"
  ],
  "title": "PlanResult",
  "type": "object"
}
