{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string"
    },
    "decision_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocked_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "field": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unlock": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "code",
                  "detail"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "node": {
            "type": "string"
          },
          "receipt_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reproducibility": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "enum": [
                      "reproducible",
                      "partially_reproducible",
                      "non_reproducible",
                      "unknown"
                    ]
                  },
                  "reasons": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "level"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "result_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "refused",
              "provider_failure",
              "no_route",
              "skipped"
            ]
          }
        },
        "required": [
          "node",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "order": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan_run": {
      "type": "string"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "reproducibility": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "reproducible",
            "partially_reproducible",
            "non_reproducible",
            "unknown"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "refused",
        "provider_failure",
        "ambiguous",
        "no_route",
        "planned"
      ]
    },
    "synthesis": {
      "additionalProperties": false,
      "properties": {
        "failures": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "handoffs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "items": {
