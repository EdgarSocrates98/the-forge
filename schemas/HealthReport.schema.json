{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "checks": {
      "items": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "unavailable"
      ]
    }
  },
  "required": [
    "status"
  ],
  "title": "HealthReport",
  "type": "object"
}
