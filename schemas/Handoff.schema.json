{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created_at": {
      "type": "string"
    },
    "dropped": {
      "type": "integer"
    },
    "items": {
      "items": {
        "properties": {
          "also_from": {
            "items": {
              "properties": {
                "node": {
                  "type": "string"
                },
                "plan_run": {
                  "type": "string"
                },
                "provider": {
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "type": "object"
                },
                "run_id": {
                  "type": "string"
                }
              },
              "required": [
                "plan_run",
                "node",
                "run_id",
                "provider"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "artifact_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim": {
            "type": "string"
          },
          "derived_from": {
            "anyOf": [
              {
                "properties": {
                  "item": {
                    "type": "string"
                  },
                  "node": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "plan_run": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "provider": {
                    "type": "string"
                  },
                  "run_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "provider",
                  "run_id",
                  "item"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "epistemic": {
            "anyOf": [
              {
                "enum": [
                  "confirmed",
                  "observed",
                  "inferred",
                  "proposed",
                  "unresolved"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "evidence",
              "finding",
              "artifact",
              "decision",
              "constraint",
              "assumption",
              "verification"
            ]
          },
          "location": {
            "anyOf": [
              {
                "properties": {
                  "line": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "properties": {
              "node": {
                "type": "string"
              },
              "plan_run": {
                "type": "string"
              },
              "provider": {
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "type": "object"
              },
              "run_id": {
                "type": "string"
              }
            },
            "required": [
              "plan_run",
              "node",
              "run_id",
              "provider"
            ],
            "type": "object"
          },
          "severity": {
            "anyOf": [
              {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "origin"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan_run": {
      "type": "string"
    },
    "producer": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "schema": {
      "type": "string"
    },
    "target_node": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "producer",
    "created_at",
    "plan_run",
    "target_node"
  ],
  "title": "Handoff",
  "type": "object"
}
