{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created_at": {
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "properties": {
            "code": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "field": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unlock": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "detail"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "type": "string"
    },
    "forge_version": {
      "type": "string"
    },
    "inputs": {
      "properties": {
        "context_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "routing_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_sha256": {
          "type": "string"
        }
      },
      "required": [
        "task_sha256"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "producer": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "provider": {
      "anyOf": [
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "manifest_sha256": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "trust": {
              "enum": [
                "builtin",
                "trusted",
                "local",
                "unverified",
                "blocked"
              ]
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "trust"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "refused",
        "provider_failure",
        "ambiguous",
        "no_route"
      ]
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "producer",
    "created_at",
    "status",
    "run_id",
    "forge_version",
    "inputs",
    "started_at",
    "finished_at"
  ],
  "title": "ExecutionReceipt",
  "type": "object"
}
