  "properties": {
    "action": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "context": {
      "properties": {
        "budget_bytes": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "excluded": {
          "items": {
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "signals": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "files": {
          "items": {
            "properties": {
              "bytes": {
                "type": "integer"
              },
              "lines": {
                "anyOf": [
                  {
                    "properties": {
                      "end": {
                        "type": "integer"
                      },
                      "start": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "signals": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "tier": {
                "enum": [
                  "reference",
                  "excerpt",
                  "requested"
                ]
              }
