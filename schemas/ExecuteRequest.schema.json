                },
                "unmatched_files": {
                  "type": "integer"
                }
              },
              "required": [
                "files_scanned",
                "unmatched_files"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "producer",
        "created_at",
        "status",
        "task_id",
        "provider_id",
        "root",
        "budget_bytes"
      ],
      "type": "object"
    },
    "delta": {
      "anyOf": [
        {
          "properties": {
            "baseline_ref": {
              "type": "string"
            },
            "changed_files": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
