                  "claim": {
                    "type": "string"
                  },
                  "derived_from": {
                    "anyOf": [
                      {
                        "properties": {
                          "item": {
                            "type": "string"
                          },
                          "node": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "plan_run": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "provider": {
                            "type": "string"
                          },
                          "run_id": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "provider",
                          "run_id",
                          "item"
                        ],
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "epistemic": {
                    "anyOf": [
                      {
                        "enum": [
                          "confirmed",
                          "observed",
                          "inferred",
                          "proposed",
                          "unresolved"
