        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "producer": {
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
