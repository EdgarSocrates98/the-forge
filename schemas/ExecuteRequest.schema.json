            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "producer": {
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
