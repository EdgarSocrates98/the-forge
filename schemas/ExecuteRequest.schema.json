                        "plan_run": {
                          "type": "string"
                        },
                        "provider": {
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "version": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "version"
