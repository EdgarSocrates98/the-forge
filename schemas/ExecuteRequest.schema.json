                  "type": "array"
                },
                "files_scanned": {
                  "type": "integer"
                },
                "git": {
                  "anyOf": [
                    {
                      "properties": {
                        "available": {
                          "type": "boolean"
                        },
                        "branch": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "changed_files": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "detached": {
                          "type": "boolean"
                        },
                        "dirty": {
                          "anyOf": [
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "head": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "state": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "available"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
