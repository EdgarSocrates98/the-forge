            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "used_bytes": {
          "type": "integer"
        },
        "workspace": {
          "anyOf": [
            {
              "properties": {
                "dependency_files": {
                  "items": {
                    "type": "string"
