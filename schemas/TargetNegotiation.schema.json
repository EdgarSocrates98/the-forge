{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capability": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "provider": {
      "type": "string"
    },
    "refusals": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "requirement": {
      "additionalProperties": false,
      "properties": {
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "isolation_required": {
          "type": "boolean"
        },
        "locality": {
          "enum": [
            "local",
            "local-or-remote",
            "isolated"
          ]
        },
        "network": {
          "enum": [
            "none",
            "egress",
            "required",
            "any"
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "type": "object"
    },
    "schema": {
      "type": "string"
    },
    "selected": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "producer",
    "created_at",
    "provider",
    "capability",
    "requirement"
  ],
  "title": "TargetNegotiation",
  "type": "object"
}
