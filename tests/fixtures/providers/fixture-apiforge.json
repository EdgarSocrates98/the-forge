{
  "schema": "theforge/ForgeManifest/v1",
  "id": "api-forge",
  "version": "0.0.1",
  "protocols": ["forge/v1"],
  "ops": ["describe", "health", "execute"],
  "domains": ["api"],
  "capabilities": [
    {
      "id": "api.analyze",
      "actions": ["analyze"],
      "default_action": "analyze",
      "state": "supported",
      "operation_class": "read_only",
      "description": "Analyze an OpenAPI contract (fixture standing in as the api-forge id)",
      "signals": {
        "keywords": ["api", "openapi", "rest api", "endpoint", "contract"],
        "file_globs": ["openapi.yaml", "*.yaml"],
        "dependencies": ["fastapi"]
      }
    }
  ]
}
