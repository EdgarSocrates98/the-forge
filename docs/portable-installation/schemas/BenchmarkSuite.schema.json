{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theforge.dev/schemas/BenchmarkSuite.schema.json",
  "title": "forge/BenchmarkSuite/v1",
  "$comment": "Published multi-consumer contract — every field is explicit; producer dataclass defaults exist for internal construction only (intentional strictness asymmetry, same convention as EcosystemCompatibility).",
  "type": "object",
  "required": ["schema", "id", "owner_forge", "created_at", "source", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "forge/BenchmarkSuite/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "owner_forge": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {"type": "string", "minLength": 1},
    "mode": {"enum": ["A", "B", "C"], "default": "A"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mode": {"enum": ["A", "B", "C"], "default": "A"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
