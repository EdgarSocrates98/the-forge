{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/EcosystemCompatibility/v1",
  "title": "EcosystemCompatibility",
  "type": "object",
  "required": [
    "schema",
    "release",
    "created_at",
    "producer",
    "components",
    "contracts"
  ],
  "properties": {
    "schema": {
      "const": "forge/EcosystemCompatibility/v1"
    },
    "release": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.(0[1-9]|1[0-2])$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "producer": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "version", "scheme", "source"],
        "$comment": "scheme/contract are required keys here by design even though the Python dataclass defaults them (semver / null): the published manifest is multi-consumer, so fields must be explicit rather than implicit defaults. Direction is strictness, never permissiveness.",
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "not": {"const": "latest"}
          },
          "scheme": {
            "enum": ["semver", "pep440"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "distribution": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "contract"],
        "$comment": "contract is a required key (may be null for unversioned families) — explicitness beats implicit defaults for multi-consumer manifests; see components.$comment.",
        "properties": {
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "contract": {
            "type": ["string", "null"],
            "pattern": "^(forge|theforge)/[A-Z][A-Za-z0-9]*$"
          },
          "min_major": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "max_major": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
