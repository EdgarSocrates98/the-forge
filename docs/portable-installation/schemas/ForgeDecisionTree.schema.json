{
  "$id": "forge/DecisionTree/v1",
  "title": "ForgeDecisionTree/v1",
  "type": "object",
  "required": [
    "schema",
    "feature",
    "decisions",
    "recorded_at",
    "recorded_by"
  ],
  "properties": {
    "schema": {
      "const": "forge/DecisionTree/v1"
    },
    "feature": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{1,80}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "type",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{1,8}-[0-9]{1,4}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "human",
              "investigable",
              "technical",
              "policy"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "open",
              "investigating",
              "pending-approval",
              "decided",
              "rejected",
              "reopened"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "recommendation": {
                  "type": "boolean"
                },
                "rationale": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor": {
            "type": "string"
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "reopen_condition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "recorded_by": {
      "type": "object",
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false
}
