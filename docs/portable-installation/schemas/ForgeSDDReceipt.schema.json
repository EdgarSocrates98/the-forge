{
  "$id": "forge/SDDReceipt/v1",
  "title": "ForgeSDDReceipt/v1",
  "type": "object",
  "required": [
    "schema",
    "feature",
    "phase",
    "action",
    "actor",
    "recorded_at"
  ],
  "properties": {
    "schema": {
      "const": "forge/SDDReceipt/v1"
    },
    "feature": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "explore",
        "define",
        "design",
        "plan",
        "build_report",
        "verify",
        "ship",
        "learn"
      ]
    },
    "action": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "inputs_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "refused",
        "overridden"
      ]
    },
    "override": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "undispensable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rollback_ref": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false
}
