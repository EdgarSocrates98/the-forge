{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/WorkspaceInstall/v1",
  "title": "ForgeWorkspaceInstall",
  "type": "object",
  "required": ["schema", "workspace_root", "projects", "created_at"],
  "properties": {
    "schema": {"const": "forge/WorkspaceInstall/v1"},
    "workspace_root": {"type": "string"},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "forge_id", "receipt_id"],
        "properties": {
          "path": {"type": "string"},
          "forge_id": {"type": "string"},
          "receipt_id": {"type": "string"},
          "installed_at": {"type": "string"}
        }
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "installation": {
      "type": "object",
      "description": "install-2.1: the consolidated cross-forge ownership inventory — a forge/WorkspaceInstallation/v2 document (schemas/WorkspaceInstallation.schema.json)",
      "required": ["schema"],
      "properties": {
        "schema": {"const": "forge/WorkspaceInstallation/v2"}
      }
    }
  },
  "additionalProperties": false
}
