{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/InstallationManifest/v1",
  "title": "ForgeInstallationManifest",
  "type": "object",
  "required": ["schema", "forge_id", "package", "distribution", "cli",
               "version", "install_root", "source", "installed_at",
               "installed_by"],
  "properties": {
    "schema": {"const": "forge/InstallationManifest/v1"},
    "forge_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "package": {"type": "string"},
    "distribution": {"type": "string"},
    "cli": {
      "type": "object",
      "required": ["name", "version_cmd"],
      "properties": {
        "name": {"type": "string"},
        "version_cmd": {"type": "array", "items": {"type": "string"}},
        "shim": {"type": "string"}
      }
    },
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+"},
    "install_root": {"type": "string"},
    "venv": {"type": "string"},
    "python": {
      "type": "object",
      "required": ["executable", "version"],
      "properties": {
        "executable": {"type": "string"},
        "version": {"type": "string"},
        "satisfies": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["git-checkout", "wheel", "pypi"]},
        "path": {"type": "string"},
        "ref": {"type": "string"},
        "rev": {"type": "string"},
        "editable": {"type": "boolean"},
        "spec": {"type": "string"}
      }
    },
    "installation_method": {"enum": ["git-checkout", "wheel", "pypi", "pypi-wheel"]},
    "installation_kind": {
      "enum": ["content", "service", "control-tool"],
      "description": "install-2.1: what the forge installs — host assets (content), a runtime service surface (service) or orchestration/control-plane tooling (control-tool)"
    },
    "install": {
      "type": "object",
      "description": "install-2.1: declared install surface — the orchestrator's typed argv builder only sends what is declared; absent keeps the v1 standard flag family",
      "properties": {
        "operations": {
          "type": "array",
          "items": {"enum": ["plan", "apply", "status", "doctor", "repair",
                             "update", "uninstall", "auto", "mcp-verify"]}
        },
        "flags": {
          "type": "array",
          "items": {"type": "string", "pattern": "^--[a-z0-9-]+$"}
        },
        "hosts": {
          "type": "array",
          "items": {"enum": ["claude", "devin", "codex", "copilot"]}
        },
        "scopes": {
          "type": "array",
          "items": {"enum": ["project", "workspace", "user"]}
        },
        "profiles": {
          "type": "array",
          "items": {"enum": ["minimal", "recommended", "full"]}
        },
        "approval": {"type": "string"},
        "update_policy": {"type": "string"},
        "security": {
          "type": "object",
          "properties": {
            "requires_network": {"type": "boolean"},
            "requires_credentials": {"type": "boolean"},
            "spawn_allowed": {"type": "boolean"},
            "notes": {"type": "string"}
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "description": "install-2.1: forge_ids that must install first — the consolidated plan topological-orders them",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "install_command": {
      "type": "array",
      "description": "alternate install entrypoint (argv template; {python}/{checkout}/{home}/{install_root} resolved by the delegator)",
      "items": {"type": "string"}
    },
    "environment": {"type": "object"},
    "mcp": {
      "type": "object",
      "required": ["server_name", "command", "verified"],
      "properties": {
        "server_name": {"type": "string"},
        "command": {"type": "array", "items": {"type": "string"}},
        "verified": {"type": "boolean"},
        "verify_tool": {"type": "string"}
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "integrated": {"type": "boolean"},
          "scope": {"enum": ["project", "workspace", "user"]}
        }
      }
    },
    "installed_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "installed_by": {
      "type": "object",
      "required": ["agent"],
      "properties": {
        "agent": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
