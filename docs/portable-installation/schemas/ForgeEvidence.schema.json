{
  "$id": "forge/Evidence/v1",
  "title": "ForgeEvidence/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "path",
    "produced_by"
  ],
  "properties": {
    "schema": {
      "const": "forge/Evidence/v1"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "test-run",
        "scan",
        "gate",
        "review",
        "benchmark",
        "handoff",
        "receipt",
        "convergence"
      ]
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "produced_by": {
      "type": "object",
      "required": [
        "agent",
        "command"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "produced_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "unverified"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false
}
