{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge/InstallReceipt/v1",
  "title": "ForgeInstallReceipt",
  "type": "object",
  "required": [
    "schema",
    "receipt_id",
    "forge_id",
    "operation",
    "scope",
    "target_root",
    "managed_files",
    "checks",
    "verification",
    "status",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "forge/InstallReceipt/v1"
    },
    "receipt_id": {
      "type": "string"
    },
    "forge_id": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "install",
        "install-auto",
        "update",
        "repair",
        "uninstall"
      ]
    },
    "scope": {
      "enum": [
        "project",
        "workspace",
        "user"
      ]
    },
    "target_root": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "minimal",
        "recommended",
        "full"
      ]
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "managed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "action"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "config",
              "skill",
              "agent",
              "marker",
              "mcp",
              "state",
              "launcher"
            ]
          },
          "action": {
            "enum": [
              "created",
              "updated",
              "adopted",
              "unchanged",
              "removed",
              "restored"
            ]
          }
        }
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uninstall: ledger-owned paths removed from the target."
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uninstall: paths preserved (user-modified, adopted or unsafe)."
    },
    "managed_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "marker",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "marker": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "server",
          "file",
          "action"
        ],
        "properties": {
          "server": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "env": {
      "type": "object"
    },
    "context": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "skills_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "agents_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "managed_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mcp_entries": {
          "type": [
            "integer",
            "null"
          ]
        },
        "managed_entries": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tools_exposed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNVERIFIED",
              "NOT_APPLICABLE"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Component selections: InstallContext.options snapshot (object) or component list for install-auto aggregates.",
      "items": {
        "type": "string"
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Per-action managed-file counts (created/updated/unchanged/adopted/skipped) plus `written` and `written_bytes` — measured from what the apply actually did."
    },
    "verification": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNVERIFIED",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "status": {
      "enum": [
        "planned",
        "completed",
        "failed",
        "rolled-back"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "rollback": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "restore": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "schema",
        "state"
      ],
      "properties": {
        "schema": {
          "const": "forge/InstallLifecycle/v1"
        },
        "state": {
          "enum": [
            "planned",
            "blocked",
            "failed",
            "applied",
            "partially_applied",
            "verified",
            "unverified",
            "ready",
            "certified"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution_profile": {
      "type": [
        "string",
        "null"
      ],
      "description": "Gateway/execution profile (economy|balanced|deep) for aggregate runs."
    },
    "forges": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Per-forge delegated results in install-auto receipts."
    },
    "provider_registry": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Provider-registry sync summary recorded by install-auto."
    },
    "installation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Installation doc summary for install-auto runs."
    },
    "workspace": {
      "type": [
        "object",
        "null"
      ],
      "description": "Workspace context (root, members) for install-auto runs."
    },
    "members": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Workspace members involved."
    },
    "setup": {
      "type": [
        "object",
        "null"
      ],
      "description": "Setup resolution provenance (flags>preset>yaml>defaults)."
    },
    "workspace_detection": {
      "type": [
        "object",
        "null"
      ],
      "description": "forge/WorkspaceDetection/v1 summary emitted during setup."
    },
    "recommendation": {
      "type": [
        "object",
        "null"
      ],
      "description": "forge/SpecialistRecommendation/v1 summary emitted during setup."
    },
    "onboarding": {
      "type": [
        "object",
        "null"
      ],
      "description": "forge/HostOnboarding/v1 summary emitted after successful apply."
    },
    "conflicts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object"
      },
      "description": "Cross-forge path-claim conflicts detected at plan time."
    },
    "order_notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Deterministic install-order rationale notes."
    },
    "receipts": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Child receipt references."
    },
    "results": {
      "type": [
        "object",
        "array",
        "null"
      ],
      "description": "Alias view of per-forge results."
    },
    "next_steps": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Operator next-step hints."
    },
    "plan": {
      "type": [
        "object",
        "null"
      ],
      "description": "Planned operation detail for dry-run receipts."
    },
    "plan_token": {
      "type": [
        "string",
        "null"
      ],
      "description": "Approval token binding a plan to an authorized apply."
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "description": "Approval metadata when the run required confirmation."
    }
  },
  "additionalProperties": false
}
